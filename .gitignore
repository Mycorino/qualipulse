# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/
env/

# Environment — never commit secrets
backend/.env

# Database
backend/*.db
backend/*.db-shm
backend/*.db-wal

# Uploads (audio files)
backend/uploads/

# Node
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/

# macOS
.DS_Store
**/.DS_Store

# IDEs
.vscode/
.idea/
auto_interview.db.bak-*
.claude/worktrees/

# Symlinked node_modules (worktree previews reuse the main checkout deps);
# the trailing-slash pattern above does not match a symlink.
frontend/node_modules

# macOS Finder / file-sync duplicate copies ("foo 2.py"). They are stale
# snapshots that shadow real modules and twice nearly rode into a commit —
# a duplicated alembic migration would double-head the migration chain.
* 2.*
