{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5173"
      ],
      "port": 5173,
      "cwd": "frontend"
    },
    {
      "name": "backend",
      "runtimeExecutable": "/opt/anaconda3/bin/uvicorn",
      "runtimeArgs": [
        "app.main:app",
        "--port",
        "8000"
      ],
      "port": 8000,
      "cwd": "backend"
    },
    {
      "name": "backend-security-preview",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "DATABASE_URL=sqlite:///./preview_security.db",
        "SENDGRID_API_KEY=",
        "/opt/anaconda3/bin/uvicorn",
        "app.main:app",
        "--port",
        "8097"
      ],
      "port": 8097,
      "cwd": "backend"
    },
    {
      "name": "frontend-security-preview",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_BACKEND_URL=http://localhost:8097",
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "5197"
      ],
      "port": 5197,
      "cwd": "frontend"
    },
    {
      "name": "backend-panel-join",
      "runtimeExecutable": "/opt/anaconda3/bin/uvicorn",
      "runtimeArgs": [
        "app.main:app",
        "--port",
        "8098"
      ],
      "port": 8098,
      "cwd": ".claude/worktrees/panel-join/backend"
    },
    {
      "name": "frontend-panel-join",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_BACKEND_URL=http://localhost:8098",
        "npm",
        "run",
        "dev",
        "--",
        "--port",
        "5198"
      ],
      "port": 5198,
      "cwd": ".claude/worktrees/panel-join/frontend"
    }
  ]
}