# Copy to .env and fill in values before running docker-compose

# Database
POSTGRES_PASSWORD=changeme

# App
SECRET_KEY=generate-a-random-32-char-string
ENVIRONMENT=production
APP_BASE_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com

# AI (required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Claude model overrides (optional). Blank = pinned defaults in
# backend/app/services/ai_models.py. Set these to swap a model in prod without
# a code deploy (e.g. when Anthropic retires one). MODEL_AUTO_LATEST=true picks
# the newest available model per family from the Models API at startup.
MODEL_SONNET=
MODEL_OPUS=
MODEL_HAIKU=
MODEL_AUTO_LATEST=false

# Email (optional — falls back to console logging)
SENDGRID_API_KEY=
# SendGrid Event Webhook signature key (base64 DER public key, from
# SendGrid > Settings > Mail Settings > Event Webhook > Signed Webhook).
# Required in production: POST /email/events returns 403 without it.
SENDGRID_WEBHOOK_PUBLIC_KEY=

# Stripe (optional — billing disabled without these)
STRIPE_SECRET_KEY=
# Publishable key (pk_test_/pk_live_) — enables in-app Embedded Checkout.
# Leave blank to fall back to the hosted checkout.stripe.com redirect.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Enable ONLY after configuring tax registration in the Stripe dashboard —
# checkout session creation fails otherwise. Adds automatic VAT + VAT-ID
# collection to Checkout.
STRIPE_AUTOMATIC_TAX=false
# Stripe Customer Portal login page (Settings > Billing > Customer portal).
# Permanent URL, e.g. https://billing.stripe.com/p/login/xxxx — customers
# enter their email and Stripe mails them a link into their own portal.
# Surfaced in billing emails, and only to workspaces that already have a
# Stripe customer. Leave blank to omit the link.
STRIPE_PORTAL_LOGIN_URL=

# Security
# haveibeenpwned breach check on new passwords (k-anonymity API, fail-open).
# Always on when ENVIRONMENT=production; set true to force-enable elsewhere.
PASSWORD_BREACH_CHECK=false

# Google Sign-In (optional — disabled if any are blank).
# Register the redirect URI in Google Cloud Console → Credentials → OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Error tracking (optional)
SENTRY_DSN=

# Cloudflare R2 storage (optional — local disk used if not set)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Abuse / cost protection
# Per-workspace daily AI spend ceilings in USD (0 disables each gate).
COPILOT_DAILY_COST_LIMIT_USD=25
INTERVIEW_DAILY_COST_LIMIT_USD=50

# Data retention
# Purge participant audio (recordings + TTS) N days after interview
# completion when POST /admin/retention/run fires. 0 = disabled.
# Transcripts are always kept.
RETENTION_AUDIO_DAYS=0

# Port for the frontend container (default 80)
PORT=80
