server {
    listen 8080;
    root /usr/share/nginx/html;
    index index.html;

    # Prerendered marketing home (scripts/prerender.mjs). dist/index.html
    # stays the empty SPA shell used as fallback for app routes, so
    # authenticated pages never flash marketing content.
    location = / {
        try_files /home.html /index.html;
    }

    # Behind Cloud Run, nginx listens on 8080 over http; an absolute
    # directory redirect would leak "http://host:8080/..." and dead-end.
    # Relative redirects keep the public scheme/host if one ever fires.
    absolute_redirect off;

    # SPA fallback. Prerendered public routes (terms/, privacy/, ...) are
    # served directly as $uri/index.html, WITHOUT the trailing-slash
    # directory redirect ($uri/ would 301 /terms -> /terms/), so the
    # canonical slash-less URL answers 200 with content.
    location / {
        try_files $uri $uri/index.html $uri/ /index.html;
    }

    # sitemap.xml is generated by the backend so published articles (and
    # their lastmod dates) are always listed. robots.txt still advertises it
    # at this public URL.
    location = /sitemap.xml {
        proxy_pass ${BACKEND_URL}/sitemap.xml;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Blog: server-rendered by the backend so crawlers and link unfurlers get
    # full HTML + per-post meta without JavaScript. rewrite + variable-free
    # proxy_pass (a variable in proxy_pass would require a runtime resolver).
    # In-app SPA navigation to these URLs never hits nginx.
    location = /blog {
        rewrite ^ /blog/pages break;
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ~ ^/blog/[A-Za-z0-9-]+$ {
        rewrite ^/blog/(.*)$ /blog/pages/$1 break;
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy API calls to backend Cloud Run service
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_set_header Host ${BACKEND_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
        client_max_body_size 55m;
    }

    # Proxy audio file serving
    location /audio/ {
        proxy_pass ${BACKEND_URL}/audio/;
        proxy_set_header Host ${BACKEND_HOST};
    }

    # Security headers
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options DENY;
    add_header X-XSS-Protection "1; mode=block";
    add_header Referrer-Policy strict-origin-when-cross-origin;
    # Content Security Policy — defense in depth against XSS + clickjacking.
    # - 'unsafe-inline' on style-src is required for Vite's CSS-in-JS and the
    #   inline React styles we use across the app (style={{...}} props).
    # - 'unsafe-inline' on script-src is intentionally omitted; if you ever
    #   need it for a hot-fix, prefer a nonce.
    # - 'unsafe-hashes' + the sha256 hash allow exactly one inline event
    #   handler: onclick="window.print()" — the Print/Save-as-PDF button in
    #   the exported report documents. Those documents open as blob: tabs,
    #   which inherit THIS policy from the SPA that created them, so the
    #   allowance must live here. Hash = base64(sha256("window.print()")).
    #   If the handler text in backend/app/services/report_export.py ever
    #   changes, recompute: echo -n '<handler>' | openssl dgst -sha256 -binary | base64
    # - connect-src allows Stripe Checkout iframes + our own API.
    # - img-src allows data: for TipTap inline previews and R2 cover images.
    # - frame-src allows blob: so the Reports tab can embed the server-rendered
    #   report.html document (fetched with auth, mounted as a same-origin blob).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-hashes' 'sha256-MguIPR6qNR8D3B+eAlK+bIRTZe8t3wkOY4B/56Me9FU=' https://js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.qualipulse.com https://api.stripe.com https://maps.googleapis.com https://*.sentry.io; frame-src 'self' blob: https://js.stripe.com https://hooks.stripe.com; media-src 'self' blob: https:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";
    add_header Permissions-Policy "microphone=(self), camera=(), geolocation=(), payment=(self)";

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
